# ==========================================================
# SELL TIME PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# ==========================================================

# 1. AI Gemini Coach & Job Recommendation
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Cloud PostgreSQL Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Auth thật: cấu hình riêng, server-only, mặc định tắt. Chỉ dùng project test được duyệt.
# Không sao chép credential cũ; không dùng service_role trong ứng dụng.
SELLTIME_AUTH_ENABLED=false
SELLTIME_AUTH_SUPABASE_URL=https://approved-test-project.supabase.co
SELLTIME_AUTH_SUPABASE_ANON_KEY=approved-test-anon-key-placeholder
SELLTIME_AUTH_ORIGIN=http://localhost:3000

# 3. PayOS VietQR Payment Gateway (Optional for real VietQR)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
